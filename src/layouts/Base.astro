---
// Every page's frame: the head (title, description, canonical URL, the language versions, Open
// Graph and Twitter cards, the feed), the nav, the page and the footer.
import interTight from '@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url';
import phudu from '@fontsource-variable/phudu/files/phudu-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import { t } from '../lib/i18n.ts';
import { absolute, href, rssPath } from '../lib/posts.ts';
import { blog, brand, localized, primaryLanguage } from '../lib/site.ts';

interface Props {
  title: string;
  description: string;
  lang: string;
  /** This page's path, before the base: its canonical URL */
  path: string;
  section?: 'home' | 'projects' | undefined;
  /** This page in every language it exists in, itself included */
  alternates?: Array<{ lang: string; path: string }> | undefined;
  /** og:image, a site path; the default share card otherwise */
  image?: string | undefined;
  imageAlt?: string | undefined;
  article?: { published: Date; modified?: Date | undefined; tags: string[] } | undefined;
  noindex?: boolean;
}
const { title, description, lang, path, section, alternates = [], image, imageAlt, article, noindex = false } = Astro.props;
const site = Astro.site;
const canonical = absolute(path, site);
const siteName = localized(blog.title, lang) ?? brand.displayName;
const fullTitle = title === siteName ? `${siteName} | ${brand.displayName}` : `${title} | ${brand.displayName}`;
const ogImage = absolute(image ?? '/og-default.png', site);
const ogAlt = image ? (imageAlt ?? title) : `${siteName}, ${brand.displayName}`;
const xDefault = alternates.find((a) => a.lang === 'en') ?? alternates.find((a) => a.lang === primaryLanguage);
const words = t(lang);
---
<!doctype html>
<html lang={lang} data-theme="night">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Before the first paint: the reader's choice, else their system's, else night -->
    <script is:inline>
      (function () {
        var stored = null;
        try { stored = localStorage.getItem('theme'); } catch (e) {}
        var theme = stored === 'day' || stored === 'night' ? stored : matchMedia('(prefers-color-scheme: light)').matches ? 'day' : 'night';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
    <meta name="theme-color" content="#141413" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {alternates.length > 1 && alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={absolute(a.path, site)} />)}
    {alternates.length > 1 && xDefault && <link rel="alternate" hreflang="x-default" href={absolute(xDefault.path, site)} />}
    <link rel="alternate" type="application/rss+xml" title={`${siteName} (${brand.displayName})`} href={href(rssPath(lang))} />
    <link rel="sitemap" href={href('/sitemap-index.xml')} />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <link rel="preload" href={interTight} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={phudu} as="font" type="font/woff2" crossorigin />
    <meta name="author" content={brand.displayName} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogAlt} />
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    {article?.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
    {article && <meta property="article:author" content={`https://github.com/${brand.github}`} />}
    {article?.tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <Analytics />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a href="#main" class="sr-only z-50 rounded-lg bg-text px-4 py-2 text-ground focus:not-sr-only focus:fixed focus:top-4 focus:left-4">{words.skip}</a>
    <Nav lang={lang} section={section} alternates={alternates} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <script is:inline>
      document.getElementById('theme-toggle')?.addEventListener('click', function () {
        var next = document.documentElement.getAttribute('data-theme') === 'day' ? 'night' : 'day';
        document.documentElement.setAttribute('data-theme', next);
        try { localStorage.setItem('theme', next); } catch (e) {}
      });
    </script>
  </body>
</html>
