---
// A card of the three-column grid: title, the description, then the project and the date. The whole
// card is the link.
import { formatDate } from '../lib/i18n.ts';
import { href, postPath, type Post, type Project } from '../lib/posts.ts';

interface Props {
  post: Post;
  project?: Project | undefined;
}
const { post, project } = Astro.props;
const { title, description, pubDate } = post.entry.data;
---
<article class="card group relative flex min-h-[15rem] flex-col p-6 transition-colors hover:border-rail">
  <h3 class="text-[20px] leading-[1.35] font-semibold tracking-[-0.005em] text-balance">
    <a href={href(postPath(post))} class="after:absolute after:inset-0 after:rounded-xl focus-visible:outline-none group-has-[:focus-visible]:underline">{title}</a>
  </h3>
  <p class="mt-2 line-clamp-3 text-[15px] leading-relaxed text-muted">{description}</p>
  <div class="mt-auto flex items-center justify-between gap-4 pt-6">
    {project ? (
      <span class="flex min-w-0 items-center gap-2 text-[14px] font-medium">
        <span class="size-2.5 shrink-0 rounded-full" style={`background: ${project.colour}`} aria-hidden="true"></span>
        <span class="truncate">{project.name}</span>
      </span>
    ) : <span></span>}
    <time datetime={pubDate.toISOString()} class="stamp shrink-0">{formatDate(pubDate, post.lang)}</time>
  </div>
</article>
