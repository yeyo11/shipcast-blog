---
// The few icons the template draws, inline and in currentColor. The GitHub mark is from Simple Icons
// (CC0).
interface Props {
  name: 'rss' | 'sun' | 'moon' | 'github' | 'star';
  size?: number;
  class?: string;
}
const { name, size = 18, class: className } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" class={className} aria-hidden="true" focusable="false">
  {name === 'rss' && (
    <g fill="currentColor">
      <circle cx="5.5" cy="18.5" r="2.25" />
      <path d="M3.25 9.6v3.05a8.1 8.1 0 0 1 8.1 8.1h3.05A11.15 11.15 0 0 0 3.25 9.6Zm0-6.35v3.05a14.45 14.45 0 0 1 14.45 14.45h3.05A17.5 17.5 0 0 0 3.25 3.25Z" />
    </g>
  )}
  {name === 'sun' && (
    <g fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round">
      <circle cx="12" cy="12" r="4.2" />
      <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.55 1.55M17.15 17.15l1.55 1.55M5.3 18.7l1.55-1.55M17.15 6.85l1.55-1.55" />
    </g>
  )}
  {name === 'moon' && <path fill="currentColor" d="M20.2 14.6A8.6 8.6 0 0 1 9.4 3.8a.6.6 0 0 0-.8-.72A9.6 9.6 0 1 0 20.92 15.4a.6.6 0 0 0-.72-.8Z" />}
  {name === 'github' && (
    <path fill="currentColor" d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.07 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .32.21.69.82.57A12 12 0 0 0 12 .3Z" />
  )}
  {name === 'star' && <path fill="currentColor" d="m12 2.6 2.86 6.04 6.64.82-4.9 4.56 1.27 6.56L12 17.33 6.13 20.58l1.27-6.56-4.9-4.56 6.64-.82Z" />}
</svg>
