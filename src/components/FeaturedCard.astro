---
// The latest launch, large: the cover on the left, then its title, lede, author and date.
import Author from './Author.astro';
import Cover from './Cover.astro';
import { formatDate, t } from '../lib/i18n.ts';
import { href, postPath, type Post, type Project } from '../lib/posts.ts';
import { lookOf } from '../lib/site.ts';

interface Props {
  post: Post;
  project?: Project | undefined;
}
const { post, project } = Astro.props;
const { title, description, pubDate, cover, image, coverAlt, imageAlt } = post.entry.data;
const src = cover ?? project?.cover ?? image;
const alt = cover ? coverAlt : project?.cover ? '' : imageAlt;
const colour = project?.colour ?? lookOf(post.entry.data.translationKey).colour;
---
<article class="card group relative grid overflow-hidden transition-colors hover:border-rail md:grid-cols-[minmax(0,1.9fr)_minmax(0,1fr)]">
  <div class="aspect-[40/21] min-w-0 overflow-hidden border-b md:aspect-auto md:min-h-[21rem] border-hairline md:border-r md:border-b-0">
    <Cover src={src} alt={alt} colour={colour} label={project?.name ?? t(post.lang).home} priority />
  </div>
  <div class="flex flex-col p-6 md:p-8 md:pt-7">
    <h2 class="text-[22px] leading-[1.3] font-semibold tracking-[-0.01em] text-balance md:text-[24px]">
      <a href={href(postPath(post))} class="after:absolute after:inset-0 after:rounded-xl focus-visible:outline-none group-has-[:focus-visible]:underline">{title}</a>
    </h2>
    <p class="mt-3 text-[16px] leading-relaxed text-muted">{description}</p>
    <div class="mt-auto flex items-center justify-between gap-4 pt-8">
      <Author />
      <time datetime={pubDate.toISOString()} class="stamp shrink-0">{formatDate(pubDate, post.lang)}</time>
    </div>
  </div>
</article>
