---
// The author as the cards and the article sign it: the photo from brand.yml's `avatar`, else the
// initials on a neutral disc, and the name.
import { initials } from '../lib/art.ts';
import { brand } from '../lib/site.ts';
---
<span class="flex min-w-0 items-center gap-2.5 text-[14px] font-medium">
  {brand.avatar ? (
    <img src={brand.avatar} alt="" width="24" height="24" class="size-6 shrink-0 rounded-full object-cover" loading="lazy" />
  ) : (
    <span class="grid size-6 shrink-0 place-items-center rounded-full border border-hairline bg-ground text-[10px] font-semibold text-muted" aria-hidden="true">{initials(brand.displayName)}</span>
  )}
  <span class="truncate">{brand.displayName}</span>
</span>
